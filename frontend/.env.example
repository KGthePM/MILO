# Milo runtime mode: "local" (default, uses Express+SQLite backend) or "cloud" (Supabase + BYOK).
VITE_MILO_MODE=local

# Required only when VITE_MILO_MODE=cloud
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: enables the "Find a movie / series" lookup in the Movie and TV
# Add/Edit modals. Use the TMDB "API Read Access Token" (the long v4 one) from
# https://www.themoviedb.org/settings/api. Leave blank to hide the lookup.
VITE_TMDB_TOKEN=
